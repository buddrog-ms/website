{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "strzesak.info"
        }
      ],
      "destination": "https://www.strzesak.info/:path*",
      "permanent": true
    },
    {
      "source": "/project/:path*",
      "destination": "https://www.strzesak.info/#projects",
      "permanent": true
    },
    {
      "source": "/project.html",
      "destination": "https://www.strzesak.info/#projects",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"develop\" ]; then exit 0; else exit 1; fi"
}
