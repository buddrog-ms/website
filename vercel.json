{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "strzesak.info" }
      ],
      "destination": "https://www.strzesak.info/:path*",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [{ "type": "query", "key": "id", "value": "modernizacja-drog" }],
      "destination": "https://www.strzesak.info/project/modernizacja-drog",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [{ "type": "query", "key": "id", "value": "odsniezanie" }],
      "destination": "https://www.strzesak.info/project/odsniezanie",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [{ "type": "query", "key": "id", "value": "rozbiorka-budynku" }],
      "destination": "https://www.strzesak.info/project/rozbiorka-budynku",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [{ "type": "query", "key": "id", "value": "transport-materialow" }],
      "destination": "https://www.strzesak.info/project/transport-materialow",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [{ "type": "query", "key": "id", "value": "drenaze" }],
      "destination": "https://www.strzesak.info/project/drenaze",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/project/:id",
      "destination": "/project/:id.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"develop\" ]; then exit 0; else exit 1; fi"
}
