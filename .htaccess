RewriteEngine On

# Redirect the production apex domain and HTTP traffic to the canonical HTTPS host.
RewriteCond %{HTTP_HOST} ^strzesak\.info$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.strzesak.info%{REQUEST_URI} [R=301,L]

# Redirect legacy public filenames to their canonical clean URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect legacy query-string project URLs to their static SEO pages.
RewriteCond %{THE_REQUEST} \s/+project\.html\?id=modernizacja-drog(?:[&\s]) [NC]
RewriteRule ^project\.html$ /project/modernizacja-drog [R=301,L]
RewriteCond %{THE_REQUEST} \s/+project\.html\?id=odsniezanie(?:[&\s]) [NC]
RewriteRule ^project\.html$ /project/odsniezanie [R=301,L]
RewriteCond %{THE_REQUEST} \s/+project\.html\?id=rozbiorka-budynku(?:[&\s]) [NC]
RewriteRule ^project\.html$ /project/rozbiorka-budynku [R=301,L]
RewriteCond %{THE_REQUEST} \s/+project\.html\?id=transport-materialow(?:[&\s]) [NC]
RewriteRule ^project\.html$ /project/transport-materialow [R=301,L]
RewriteCond %{THE_REQUEST} \s/+project\.html\?id=drenaze(?:[&\s]) [NC]
RewriteRule ^project\.html$ /project/drenaze [R=301,L]

# Serve each project from its own static HTML page through a clean URL.
RewriteRule ^project/([a-z0-9-]+)/?$ project/$1.html [L,NC]
