RewriteEngine On

# Redirect the production apex domain and HTTP traffic to the canonical HTTPS host.
RewriteCond %{HTTP_HOST} ^strzesak\.info$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.strzesak.info%{REQUEST_URI} [R=301,L]

# Redirect legacy public filenames to their canonical clean URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Serve project details through clean, shareable URLs.
RewriteRule ^project/([a-z0-9-]+)/?$ project.html?id=$1 [L,QSA,NC]