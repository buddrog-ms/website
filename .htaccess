RewriteEngine On

# Redirect legacy public filenames to their canonical clean URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Serve project details through clean, shareable URLs.
RewriteRule ^project/([a-z0-9-]+)/?$ project.html?id=$1 [L,QSA,NC]