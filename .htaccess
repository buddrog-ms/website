RewriteEngine On

# Redirect the production apex domain and HTTP traffic to the canonical HTTPS host.
RewriteCond %{HTTP_HOST} ^strzesak\.info$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.strzesak.info%{REQUEST_URI} [R=301,L]

# Redirect legacy public filenames to their canonical clean URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# The site is now a single page: send legacy project pages (/project/*, project.html) to the projects section.
RewriteRule ^project(?:/.*)?$ https://www.strzesak.info/#projects [R=301,NE,L,NC]
RewriteRule ^project\.html$ https://www.strzesak.info/#projects [R=301,NE,L]

# Gzip compression for text assets.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/javascript text/javascript application/json application/ld+json image/svg+xml
</IfModule>

# Browser caching for static assets (Core Web Vitals / PageSpeed).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:webp|png|jpe?g|svg|ico|mp4|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(?:html|xml|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
